[Unit]
Description=AI Trading Signal Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wufeng
WorkingDirectory=/home/wufeng/AI_Trading
ExecStart=/home/wufeng/venv/bin/python scripts/run_daemon.py
Restart=on-failure
RestartSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
