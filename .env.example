# LLM API Keys (configure at least one)
ANTHROPIC_API_KEY=sk-ant-xxx
ZHIPU_API_KEY=xxx

# LLM Provider: "claude" or "zhipu"
LLM_PROVIDER=claude
# LLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # 智谱
# LLM_MODEL=glm-4.5-air  # 留空则用各 client 默认值

# WeChat Webhook
