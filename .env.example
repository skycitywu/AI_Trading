# LLM API Keys (configure at least one)
ANTHROPIC_API_KEY=sk-ant-xxx
ZHIPU_API_KEY=xxx

# LLM Provider: "claude" or "zhipu"
LLM_PROVIDER=claude
# LLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # 智谱
# LLM_MODEL=glm-4.5-air  # 留空则用各 client 默认值

# WeChat Webhook（企业微信群机器人）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# PushPlus（微信公众号推送，关注"pushplus推送加"公众号获取 token）
# PUSHPLUS_TOKEN=xxx
# PUSHPLUS_TOPIC=xxx  # 群组码，不填则只推给自己

# Database
DATABASE_URL=sqlite:///data/trading.db
