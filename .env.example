# LLM API Keys (configure at least one provider)
ANTHROPIC_API_KEY=sk-ant-xxx
ZHIPU_API_KEY=xxx

# Gemini (Google AI Studio)
GEMINI_API_KEY=AIza-xxx

# LLM Provider: "claude", "zhipu", or "gemini"
LLM_PROVIDER=gemini
# LLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # 仅智谱需要
# LLM_MODEL=gemini-3-flash-preview  # 留空则用各 client 默认值
#   gemini 备选: gemini-3-flash-preview / gemini-2.5-flash / gemini-3.1-pro-preview(需付费 key)

# WeChat Webhook（企业微信群机器人）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# PushPlus（微信公众号推送，关注"pushplus推送加"公众号获取 token）
# PUSHPLUS_TOKEN=xxx
# PUSHPLUS_TOPIC=xxx  # 群组码，不填则只推给自己

# Database
DATABASE_URL=sqlite:///data/trading.db
